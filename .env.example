# Hearth — environment (copy to .env and fill in; never commit .env)
#
# Every value is read from the process environment; a `.env` file in the
# project root is loaded automatically (api/lib/env.mjs). A variable that is
# already exported always wins over the line in the file.
# See docs/CONFIGURATION.md for the full reference.

# ===== Database ==============================================================
# One DSN; when set it overrides the PG* fallbacks below.
DATABASE_URL=postgresql://hearth:change-me@127.0.0.1:5432/hearth
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=hearth
# PGUSER=hearth
# PGPASSWORD=change-me

# Used only by docker-compose.yml for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# Database the test suite resets (only names ending in _test are ever wiped).
# Default: DATABASE_URL with `_test` appended to the database name.
# TEST_DATABASE_URL=postgresql://hearth:change-me@127.0.0.1:5432/hearth_test

# ===== API process ===========================================================
PORT=8787
# Address to bind. Default 127.0.0.1 (put a TLS reverse proxy in front).
# Inside a container set 0.0.0.0 (docker-compose.yml does).
# HOST=127.0.0.1

# Which proxies may set X-Forwarded-For (used for login throttling and the
# audit log). Default: loopback and private networks. "false" trusts nobody.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# REQUIRED. Secret that signs session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Public URL of this installation (used in password-reset e-mails).
# APP_BASE_URL=https://hearth.example.test

# Comma-separated browser origins allowed by CORS. Never '*'.
ALLOWED_ORIGINS=http://localhost:8787

# Where uploaded signature images and export files are stored.
UPLOAD_DIR=var/uploads

# ===== Clinic identity ========================================================
# Name used in e-mails sent by the API.
# CLINIC_NAME=Harbourview Medical Centre
# Build-time values for the public landing page (read by `npm run build`).
# VITE_CLINIC_NAME=Harbourview Medical Centre
# VITE_CLINIC_SHORT_NAME=Harbourview
# VITE_CLINIC_PHONE=(555) 010-0142
# VITE_CLINIC_EMAIL=hello@harbourview.example.test
# VITE_CLINIC_ADDRESS=12 Harbour Road, Example Town
# VITE_CLINIC_HOURS=Mon-Fri: 9AM-5PM

# ===== Sessions and sign-in protection ========================================
# Sign out after this many minutes without activity (default 30).
# SESSION_IDLE_MINUTES=30
# Absolute session lifetime in hours, however active (default 12).
# SESSION_MAX_HOURS=12
# Failed sign-ins per account before a lockout (default 5); the lock then
# doubles from 1 minute up to LOGIN_MAX_LOCK_MINUTES (default 60).
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_LOCK_MINUTES=60
# Failed sign-ins per IP address within LOGIN_IP_WINDOW_MINUTES (default 20 / 15).
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_IP_WINDOW_MINUTES=15
# Public booking requests accepted per IP address per hour (default 5).
# BOOKING_RATE_LIMIT_PER_HOUR=5
# Allow people to create their own (role-less) accounts. Default off.
# ALLOW_SELF_SIGNUP=false

# ===== First-start accounts ===================================================
# Created once on first start if they do not exist; never overwritten. Both
# must choose a new password at first sign-in. Use your own addresses and
# strong passwords on a real installation.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=staff@example.test
SEED_STAFF_PASSWORD=
# SEED_FORCE_PASSWORD_CHANGE=true
# SEED_ACCOUNTS=true

# ===== Optional: e-mail (OFF unless RESEND_API_KEY is set) =====================
# Sends invoices/receipts (patient name, e-mail, invoice lines) and password
# reset links through Resend, a third-party service. Leave empty to keep all
# data on your server; the app works fully without it.
RESEND_API_KEY=
RESEND_FROM_INVOICE=
RESEND_FROM_RECEIPT=
# Sender for password-reset e-mails (self-service reset exists only when set).
RESEND_FROM_SYSTEM=

# ===== Optional: AI receipt scanning (OFF unless RECEIPT_AI_API_KEY is set) ====
# The receipt image is sent to this OpenAI-compatible endpoint (a third party,
# or a model server you run yourself). Expenses work fully without it.
RECEIPT_AI_API_KEY=
# RECEIPT_AI_BASE_URL=https://api.openai.com/v1
# RECEIPT_AI_MODEL=gpt-4o-mini

# ===== Realtime tuning (optional) ==============================================
# REALTIME_POLL_MS=250
# REALTIME_PING_MS=15000
