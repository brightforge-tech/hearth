# Hearth — environment (copy to .env and fill in; never commit .env)
#
# Every value is read from the process environment; a `.env` file in the
# project root is loaded automatically (api/lib/env.mjs) without adding a
# dependency. Copy this file to `.env` and fill in the blanks. A variable that
# is already exported always wins over the line in the file.

# ===== Database ==============================================================
# Preferred: one DSN. When DATABASE_URL is set it overrides all PG* below.
# (postgresql://user:password@host:port/database)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hearth

# Fallbacks, used only when DATABASE_URL is unset:
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=hearth
PGUSER=postgres
PGPASSWORD=postgres

# Database that tests/run.mjs resets and seeds. Defaults to DATABASE_URL with
# `_test` appended to the database name; only *_test databases are ever reset.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hearth_test

# ===== API process ===========================================================
# Port for `node api/server.mjs` (serves the built SPA and /api on one port);
# the --port command-line flag overrides it.
PORT=8787

# Secret that signs the HS256 session tokens. Without it the API refuses every
# login and session request (it fails closed rather than signing with a guess).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long a freshly issued session token stays valid, in hours (default 12).
# A number like 8 or 24; anything else fails the API closed at first use.
# SESSION_TTL_HOURS=12

# Comma-separated browser origins allowed by CORS. Never '*'.
ALLOWED_ORIGINS=http://localhost:8787

# Where uploaded signature/export files live (default: var/uploads).
UPLOAD_DIR=var/uploads

# Tuning for GET /api/realtime, the SSE change feed the queue/billing/visit
# pages listen on (api/routes/realtime.mjs). Both are read per stream, so a
# restart is all it takes; leave them unset for the shipped defaults.
# How often the outbox queue is drained, in ms (default 250, floor 50).
# REALTIME_POLL_MS=250
# How often an idle stream gets a ": ping" comment, in ms (default 15000, floor
# 1000) — the keep-alive that stops a buffering proxy from closing a quiet
# connection.
# REALTIME_PING_MS=15000

# ===== Outbound e-mail (Resend) ==============================================
# Resend API key for the invoice and receipt mails.
RESEND_API_KEY=

# Resend endpoint; override only for tests (contract tests point it at a local
# stub). Default: https://api.resend.com
# RESEND_API_BASE=https://api.resend.com

# Verified sender addresses (required when RESEND_API_KEY is set).
RESEND_FROM_INVOICE=
RESEND_FROM_RECEIPT=

# ===== Seed accounts ==========================================================
# At start-up the API seeds the clinic_settings singleton and two staff accounts
# (api/lib/seed.mjs), idempotently: an existing account is never overwritten,
# so changing a password by hand survives every restart. The defaults shown are
# the development credentials the milestone checks sign in with — on a real
# deployment set your own addresses and secrets here and change the passwords.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=Admin#2025test
SEED_STAFF_EMAIL=staff@example.test
SEED_STAFF_PASSWORD=Staff#2025test

# Set to 0 to switch the start-up seed off entirely (the regression suite does).
# SEED_ACCOUNTS=0
